# URL publica do projeto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica anon/publishable do Supabase. Pode ser usada no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service role/secret do Supabase. Exclusivamente server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Runtime principal de chat local via Ollama.
AI_ENGINE_OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_CONNECT_TIMEOUT_MS=60000
OLLAMA_FIRST_TOKEN_TIMEOUT_MS=90000
OLLAMA_IDLE_TIMEOUT_MS=30000
OLLAMA_REQUEST_TIMEOUT_MS=0
# Opcional; ausente preserva o lifecycle padrao do Ollama.
# OLLAMA_KEEP_ALIVE=10m

# Chave secreta da OpenAI. So e obrigatoria quando voz e/ou visao estiverem ativas.
OPENAI_API_KEY=

# Modelo textual OpenAI reservado para integracoes futuras.
OPENAI_MODEL=

# Modelo com entrada de imagem disponivel na Responses API.
OPENAI_VISION_MODEL=

# Modelo dedicado a transcricao de audio.
OPENAI_TRANSCRIPTION_MODEL=

# Modelo dedicado a sintese de voz.
OPENAI_TTS_MODEL=

# Voz padrao suportada pelo modelo de sintese configurado.
OPENAI_TTS_VOICE=

# URL base da aplicacao, sem barra final.
NEXT_PUBLIC_APP_URL=http://localhost:3051

# Limites publicos usados na validacao do navegador. O servidor valida novamente.
NEXT_PUBLIC_MAX_IMAGE_SIZE_MB=10
NEXT_PUBLIC_MAX_AUDIO_SIZE_MB=25
NEXT_PUBLIC_MAX_DOCUMENT_SIZE_MB=5

# Habilitam os controles de voz e visao no produto.
NEXT_PUBLIC_ATTACHMENTS_ENABLED=false
NEXT_PUBLIC_VOICE_ENABLED=false
NEXT_PUBLIC_VISION_ENABLED=false

# true libera o modo local sem servicos; false exige Supabase e o runtime Ollama.
HANIRA_DEMO_MODE=true

# Versao publica exibida no health check e no diagnostico.
NEXT_PUBLIC_APP_VERSION=0.4.0
