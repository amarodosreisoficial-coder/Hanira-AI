# URL pública do projeto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública anon/publishable do Supabase. Pode ser usada no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service role/secret do Supabase. Exclusivamente server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Chave secreta da OpenAI. Exclusivamente server-side.
OPENAI_API_KEY=

# Modelo disponível no projeto OpenAI, por exemplo um modelo da Responses API.
OPENAI_MODEL=

# Modelo com entrada de imagem disponível na Responses API.
OPENAI_VISION_MODEL=

# Modelo dedicado à transcrição de áudio.
OPENAI_TRANSCRIPTION_MODEL=

# Modelo dedicado à síntese de voz.
OPENAI_TTS_MODEL=

# Voz padrão suportada pelo modelo de síntese configurado.
OPENAI_TTS_VOICE=

# URL base da aplicação, sem barra final.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Limites públicos usados na validação do navegador. O servidor valida novamente.
NEXT_PUBLIC_MAX_IMAGE_SIZE_MB=10
NEXT_PUBLIC_MAX_AUDIO_SIZE_MB=25

# Habilitam os controles de voz e visão no produto.
NEXT_PUBLIC_VOICE_ENABLED=true
NEXT_PUBLIC_VISION_ENABLED=true

# true libera o modo local sem serviços; false exige todas as credenciais.
HANIRA_DEMO_MODE=true

# Versão pública exibida no health check e no diagnóstico.
NEXT_PUBLIC_APP_VERSION=0.4.0
