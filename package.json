{
  "name": "hanira-app",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3051",
    "build": "next build",
    "start": "next start -p 3051",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --pool=threads --maxWorkers=1",
    "doctor": "node scripts/doctor.mjs",
    "test:e2e:demo": "powershell -Command \"$env:HANIRA_E2E_TARGET='chat-demo'; npx.cmd playwright test --project=chat-demo\"",
    "test:e2e:real": "powershell -Command \"if (-not $env:HANIRA_TEST_EMAIL -or -not $env:HANIRA_TEST_PASSWORD) { Write-Error 'chat-real exige HANIRA_TEST_EMAIL e HANIRA_TEST_PASSWORD configurados. O teste real nao usa fallback silencioso para demo.'; exit 1 }; $env:HANIRA_E2E_TARGET='chat-real'; npx.cmd playwright test --project=chat-real\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "16.3.3",
    "openai": "^6.48.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
